# Application Lifecycle Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local pgvector container password, read by docker-compose.yml
POSTGRES_PASSWORD=CHANGE_ME

# Vector database URL (use the same password as POSTGRES_PASSWORD)
DATABASE_URL=postgresql://rag_admin:CHANGE_ME@localhost:5432/ai_enterprise_db

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# Pipeline Hyperparameters
EMBEDDING_MODEL=text-embedding-3-small
RAG_DEFAULT_TOP_K=3

# MCP server bind address and port (Dockerfile defaults shown)
MCP_HOST=0.0.0.0
MCP_SERVER_PORT=8765
